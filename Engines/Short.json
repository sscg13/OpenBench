{
    "private": false,
    "nps": 500000,
    "protocol": "xboard",
    "source": "https://github.com/sscg13/Short",
  
    "build": {
      "path": "",
      "compilers": [ "gcc" ],
      "cpuflags": [ ],
      "systems": [ "Linux", "Windows" ]
    },
  
    "test_presets": {
  
      "default": {
        "base_branch": "main",
        "book_name": "8moves_v3.epd",
        "test_bounds": "[0.00, 10.00]",
        "test_confidence": "[0.1, 0.05]",
        "win_adj": "None",
        "draw_adj": "None"
      },
  
      "Gainer": {
        "both_options": "Threads=1 Hash=32",
        "both_time_control": "40/72",
        "workload_size": 32
      },
  
      "Nonreg": {
        "both_options": "Threads=1 Hash=128",
        "both_time_control": "40/72",
        "workload_size": 32,
        "test_bounds": "[-10.00, 0.00]"
      }
    }
  }